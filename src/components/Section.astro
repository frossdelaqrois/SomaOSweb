---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  class?: string;
}
const { eyebrow, title, intro, class: className = "" } = Astro.props;
---
<section class={`section reveal ${className}`}>
  <div class="section-heading">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
    {intro && <p>{intro}</p>}
  </div>
  <slot />
</section>
