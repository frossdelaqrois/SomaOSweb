---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import { roadmap } from "../data";
---
<BaseLayout title="Roadmap | SOMA OS">
  <Section eyebrow="Roadmap" title="The path to SOMA OS 1.0 and beyond.">
    <ol class="timeline">{roadmap.map((item, index) => <li class={index < 2 ? "done" : ""}>{item}</li>)}</ol>
  </Section>
</BaseLayout>
