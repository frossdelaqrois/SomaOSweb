---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import GlassCard from "../components/GlassCard.astro";
---
<BaseLayout title="Downloads | SOMA OS" description="Download SOMA OS builds and review release channels.">
  <Section eyebrow="Downloads" title="Builds will appear here as SOMA OS moves toward public preview.">
    <div class="grid-3">
      <GlassCard title="Alpha" text="Internal validation builds for hardware, gaming, and creator workflows." />
      <GlassCard title="Beta" text="Community testing channel for early adopters once the installer and update path are stable." />
      <GlassCard title="Public Preview" text="Signed images, checksums, release notes, and upgrade guidance for wider testing." />
    </div>
    <div class="actions"><a class="button" href="https://github.com/frossdelaqrois/SomaOSweb/releases" target="_blank" rel="noreferrer">View Releases</a></div>
  </Section>
</BaseLayout>
