---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import GlassCard from "../components/GlassCard.astro";
---
<BaseLayout title="Community | SOMA OS">
  <Section eyebrow="Community" title="For gamers, developers, and creators building together.">
    <div class="grid-3">
      <GlassCard title="GitHub" text="Issues, releases, discussions, and contributions." />
      <GlassCard title="Discord" text="Fast chat for feedback, builds, testing, and support." />
      <GlassCard title="Reddit" text="Community posts, showcases, and public updates." />
      <GlassCard title="Matrix" text="Open rooms for Linux-focused discussion." />
    </div>
  </Section>
</BaseLayout>
