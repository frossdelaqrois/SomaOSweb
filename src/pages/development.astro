---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import { devTools } from "../data";
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Development | SOMA OS">
  <Section eyebrow="Development" title="A workstation for game developers and AI creators.">
    <div class="split">
      <ul class="feature-list">{devTools.map((tool) => <li>{tool}</li>)}</ul>
      <div class="showcase"><img src={`${base}assets/screenshot-terminal.svg`} alt="Developer terminal preview" /></div>
    </div>
  </Section>
</BaseLayout>
